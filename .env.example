# ---- Shared ----
# Local Postgres from docker-compose. For Supabase, use the project's direct connection string.
DATABASE_URL=postgresql://pii:pii@localhost:54329/pii

# ---- Merchant (Node sample checkout) ----
MERCHANT_PORT=4100
MERCHANT_PUBLIC_URL=http://localhost:4100
# Shared secret the recovery worker uses to call POST /internal/reprocess. Generate your own.
WORKER_TOKEN=change-me-worker-token
# PROVIDER_MODE=simulated runs a local Stripe-shaped simulator that signs webhooks with the
# real Stripe signature scheme. PROVIDER_MODE=stripe uses a Stripe sandbox (test-mode keys).
PROVIDER_MODE=simulated
# Only for PROVIDER_MODE=stripe. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used by the simulator to sign webhooks (any random string).
SIMULATED_WEBHOOK_SECRET=whsec_local_simulated_secret

# ---- API (FastAPI) ----
API_PORT=8100
MERCHANT_URL=http://localhost:4100
# AUTH_MODE=dev trusts X-User-Id headers for seeded users. AUTH_MODE=supabase verifies Supabase JWTs.
AUTH_MODE=dev
SUPABASE_JWT_SECRET=
# AGENT_MODE=adk uses Google ADK + Gemini (needs GOOGLE_API_KEY). AGENT_MODE=deterministic uses
# the rule-based fallback investigator that calls the same scoped tools.
AGENT_MODE=auto
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
ADK_MODEL=gemini-2.5-flash
PROMPT_VERSION=v1

# ---- Web (Vite) ----
VITE_API_URL=http://localhost:8100
# Optional: enables Supabase Realtime subscriptions instead of polling.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
